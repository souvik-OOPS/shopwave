# ─────────────────────────────────────────────────────────────────────────────
# ShopWave API — copy to `.env` and fill in. NEVER commit the real .env file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
API_PREFIX=/api
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopwave?schema=public"

# ── JWT / sessions ──────────────────────────────────────────────────────────
# Must be at least 32 characters, and different from each other.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Cookies ─────────────────────────────────────────────────────────────────
# COOKIE_SECURE must be true in production (enforced at boot).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# ── Client / CORS ───────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Redis (optional — the API degrades gracefully without it) ───────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shopwave

# ── Razorpay (payments) ─────────────────────────────────────────────────────
# Test keys start with rzp_test_. The webhook secret is set in the Razorpay
# dashboard under Settings → Webhooks and is NOT the API secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google sign-in (optional) ───────────────────────────────────────────────
# Leave both blank and the Google button 503s; everything else keeps working.
# Set them together — the app refuses to boot with only one.
#
# Google Cloud console → APIs & Services → Credentials → Create OAuth client ID
#   Application type:            Web application
#   Authorised redirect URI:     must equal GOOGLE_REDIRECT_URI below, character for character
# Then OAuth consent screen → add the `openid`, `email` and `profile` scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev default points at the Vite proxy, so Google's redirect lands on the client's own
# origin and the session cookies it sets are first-party. In production this is the
# public API URL, e.g. https://api.yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ── Email (Nodemailer) ──────────────────────────────────────────────────────
# Leave MAIL_DRIVER unset and it resolves itself: SMTP if SMTP_SERVICE/SMTP_HOST is
# set, else Resend if RESEND_API_KEY is set, else console (logs the mail, sends nothing).
# Set it explicitly to override: console | smtp | resend
MAIL_DRIVER=
MAIL_FROM="ShopWave <no-reply@shopwave.test>"

# Either a Nodemailer well-known service (gmail, outlook365, zoho, …) …
SMTP_SERVICE=
# … or an explicit relay. Port 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (true).
# The docker-compose Mailpit sink listens on 127.0.0.1:1025 (no auth, no TLS) and shows
# everything it received at http://localhost:8025 — the zero-credential local default.
# Literal 127.0.0.1, not "localhost": on Windows that resolves to ::1 first and the
# connection is refused before Mailpit is ever reached.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_POOL=true

# Local development without a real relay:
#   MailHog / Mailpit → SMTP_HOST=localhost, SMTP_PORT=1025, no user/password
#   Gmail             → SMTP_SERVICE=gmail with a 16-character App Password (not your login password)
#   Ethereal          → credentials from https://ethereal.email; the log prints a preview URL

RESEND_API_KEY=

# ── Limits ──────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
MAX_REQUEST_BODY_SIZE=100kb
MAX_UPLOAD_FILE_SIZE_MB=5
MAX_UPLOAD_FILES=8

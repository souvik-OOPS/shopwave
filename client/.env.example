# ─────────────────────────────────────────────────────────────────────────────
# ShopWave client. Only VITE_-prefixed variables reach the browser bundle.
# NEVER put a secret here — everything in this file is publicly readable
# once the app is built and served.
# ─────────────────────────────────────────────────────────────────────────────

# Leave unset in development: vite.config.ts proxies /api to the API server, which
# keeps auth cookies first-party. Set this only when the API lives on another origin.
# VITE_API_URL=https://api.yourdomain.com/api
